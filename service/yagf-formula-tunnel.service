[Unit]
Description=YAGF SSH tunnel to formula recognition
After=network-online.target

[Service]
EnvironmentFile=%h/.config/yagf/formula-host.env
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o IdentitiesOnly=yes -i %h/.ssh/yagf_jetson_formulas -L 127.0.0.1:8082:127.0.0.1:8082 ${YAGF_JETSON_HOST}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
