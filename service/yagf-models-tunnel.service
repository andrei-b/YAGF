[Unit]
Description=YAGF SSH tunnel to model discovery and PP-FormulaNet
After=network-online.target

[Service]
EnvironmentFile=%h/.config/yagf/models-host.env
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o IdentitiesOnly=yes -i %h/.ssh/yagf_jetson_models -L 127.0.0.1:8769:127.0.0.1:8769 -L 127.0.0.1:8772:127.0.0.1:8772 ${YAGF_JETSON_HOST}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
