[Unit]
Description=YAGF SSH tunnel to the symbol training worker
After=network-online.target

[Service]
EnvironmentFile=%h/.config/yagf/symbol-tunnel.env
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o IdentitiesOnly=yes -i %h/.ssh/yagf_jetson_symbols -L 127.0.0.1:8770:127.0.0.1:8770 ${YAGF_JETSON_HOST}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
