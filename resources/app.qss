QMainWindow#yagfWindow {
    background: #e9eef5;
    color: #24354b;
    font-family: "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 10pt;
}

QMenuBar {
    background: #ffffff;
    color: #304158;
    border-bottom: 1px solid #dce4ee;
    padding: 3px 9px;
}
QMenuBar::item { padding: 6px 11px; border-radius: 5px; }
QMenuBar::item:selected { background: #e9f2ff; color: #175ca9; }
QMenu { background: #ffffff; color: #304158; border: 1px solid #dce4ee; padding: 5px; }
QMenu::item { padding: 6px 24px 6px 18px; border-radius: 4px; }
QMenu::item:selected { background: #e9f2ff; color: #175ca9; }

QToolBar#mainToolbar {
    background: #ffffff;
    border: 0;
    border-bottom: 1px solid #dce4ee;
    spacing: 5px;
    padding: 7px 12px;
}
QToolBar#mainToolbar::separator {
    background: #dce4ee;
    width: 1px;
    margin: 5px 7px;
}
QToolBar#mainToolbar QToolButton {
    background: transparent;
    color: #334962;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 8px;
}
QToolBar#mainToolbar QToolButton:hover { background: #eef4fb; }
QToolBar#mainToolbar QToolButton:pressed,
QToolBar#mainToolbar QToolButton:checked {
    background: #e1edfb;
    border-color: #c6daf4;
    color: #155caa;
}
QToolBar#mainToolbar QToolButton:disabled { color: #9daabd; }
QToolBar#mainToolbar QToolButton#primaryButton {
    background: #216ec1; color: white; border-color: #216ec1;
    font-weight: 700; padding: 8px 10px;
}
QToolBar#mainToolbar QToolButton#primaryButton:hover { background: #145fae; }
QToolBar#mainToolbar QToolButton#primaryButton:disabled { background: #e7edf4; color: #a1acba; border-color: #e1e6ed; }
QToolButton#primaryButton::menu-button { border-left: 1px solid rgba(255,255,255,85); width: 20px; }
QToolBar#imageToolbar {
    background: rgba(255, 250, 242, 160);
    border: 1px solid rgba(166, 155, 139, 110);
    border-radius: 9px; spacing: 3px; padding: 4px;
}
QToolBar#imageToolbar QToolButton {
    background: transparent; border: 1px solid transparent; border-radius: 5px;
    color: #334962; padding: 5px;
}
QToolBar#imageToolbar QToolButton:hover { background: rgba(247, 236, 216, 185); }
QToolBar#imageToolbar QToolButton:checked { background: rgba(205, 226, 251, 180); border-color: #adc9eb; }
QToolBar#imageToolbar QToolButton#imageSmartSplitButton { padding-right: 19px; }
QToolBar#imageToolbar QToolButton::menu-button {
    background: rgba(255, 250, 242, 60);
    border: 0; border-left: 1px solid rgba(166, 155, 139, 65);
    border-top-right-radius: 5px; border-bottom-right-radius: 5px;
    width: 14px;
}
QToolBar#imageToolbar QToolButton::menu-button:hover { background: rgba(247, 236, 216, 135); }
QToolBar#imageToolbar QToolButton::menu-button:pressed { background: rgba(225, 212, 192, 160); }
QToolBar#imageToolbar::separator { background: rgba(166,155,139,85); width: 1px; margin: 4px; }
QLabel#toolbarCaption { color: #718096; padding-left: 2px; }
QToolBar#formatToolbar { background: transparent; border: 0; spacing: 4px; padding: 0; }
QToolBar#formatToolbar QToolButton {
    color: #536981;
    background: #f4f7fb;
    border: 1px solid #e1e8f1;
    border-radius: 5px;
    padding: 4px 8px;
}
QToolBar#formatToolbar QToolButton:hover { background: #e9f2ff; color: #175ca9; }
QToolBar#formatToolbar QToolButton:checked { background: #deecfc; color: #155caa; border-color: #b5cfea; }

QWidget#navigationPane { background: #f7f9fc; border-right: 1px solid #dce4ee; }
QWidget#textPanel { background: #ffffff; border-left: 1px solid #dce4ee; }
QLabel#sectionHeading {
    color: #72839a;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 1px;
}
QLabel#editorHeading { color: #1e3048; font-size: 13pt; font-weight: 700; }

QListWidget#pageMiniatures,
QListWidget#imageRegions,
QListWidget#recognizedWords {
    background: transparent;
    border: 0;
    outline: none;
    color: #344963;
}
QListWidget#pageMiniatures,
QListWidget#imageRegions { background: #d3dde9; }
QListWidget#pageMiniatures::item,
QListWidget#imageRegions::item,
QListWidget#recognizedWords::item { border-radius: 7px; padding: 4px; }
QListWidget#pageMiniatures::item:hover,
QListWidget#imageRegions::item:hover,
QListWidget#recognizedWords::item:hover { background: #ecf2fa; }
QListWidget#pageMiniatures::item:selected,
QListWidget#imageRegions::item:selected,
QListWidget#recognizedWords::item:selected {
    background: #deecfc;
    color: #155caa;
}
QListWidget#recognizedWords { border: 1px solid #e1e8f1; border-radius: 8px; }

QGraphicsView#pagePreview { border: 0; }
QTextEdit#recognizedTextEditor {
    background: #ffffff;
    color: #24354b;
    border: 1px solid #d7e1ed;
    border-radius: 8px;
    padding: 11px;
    selection-background-color: #bed9f9;
}
QTextEdit#recognizedTextEditor:focus { border: 1px solid #6aa5e8; }

QPushButton {
    background: #ffffff;
    color: #334962;
    border: 1px solid #ced9e6;
    border-radius: 6px;
    padding: 7px 11px;
    min-height: 20px;
}
QPushButton:hover { background: #f0f6fd; border-color: #9dbde2; }
QPushButton:pressed { background: #deebf9; }
QPushButton:disabled { color: #a1acba; background: #f5f7fa; border-color: #e1e6ed; }
QPushButton#primaryButton,
QPushButton#applyButton {
    background: #216ec1;
    color: #ffffff;
    border-color: #216ec1;
    font-weight: 700;
}
QPushButton#primaryButton:hover,
QPushButton#applyButton:hover { background: #145fae; border-color: #145fae; }
QPushButton#primaryButton:disabled,
QPushButton#applyButton:disabled { background: #e7edf4; color: #a1acba; border-color: #e1e6ed; }
QPushButton#reviewWordButton { background: #edf5ff; color: #175ca9; border-color: #c8ddf5; }
QPushButton#reviewWordButton:hover { background: #dcecff; border-color: #9dbfe9; }
QPushButton#reviewWordButton:disabled { background: #f5f7fa; color: #a1acba; border-color: #e1e6ed; }
QPushButton#pageNavButton { min-width: 23px; padding: 5px; }

QLineEdit, QSpinBox, QComboBox {
    background: #ffffff;
    color: #334962;
    border: 1px solid #ced9e6;
    border-radius: 6px;
    padding: 5px 7px;
    min-height: 20px;
    selection-background-color: #bed9f9;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #6aa5e8; }
QStatusBar { background: #ffffff; color: #718096; border-top: 1px solid #dce4ee; }
QStatusBar QLabel { color: #718096; padding: 2px 8px; }
QSplitter#workspaceSplitter::handle { background: #dce4ee; }
QSplitter#navigationSplitter::handle,
QSplitter#textEditorSplitter::handle {
    background: #dce4ee;
    border-radius: 3px;
    margin: 2px 0;
}
QSplitter#navigationSplitter::handle:hover,
QSplitter#textEditorSplitter::handle:hover { background: #9dbde2; }

QDialog#ocrServicesDialog, QWidget#recognitionPage {
    background: #f4f7fb;
    color: #263a50;
}
#ocrServicesDialog QLabel, #ocrServicesDialog QCheckBox { color: #334962; }
#ocrServicesDialog QLabel#recognitionSettingsTitle {
    font-size: 16pt; font-weight: 700; color: #20354e;
}
#recognitionSettingsTabs::pane {
    border: 1px solid #d5dfea; border-radius: 8px; padding: 1px; background: #f8fafd;
}
#recognitionSettingsTabs QTabBar::tab {
    background: transparent; border: 0; border-bottom: 3px solid transparent;
    padding: 8px 15px; color: #52677e; font-weight: 600;
}
#recognitionSettingsTabs QTabBar::tab:selected { color: #185ea9; border-bottom-color: #216ec1; }
#recognitionSettingsTabs QTabBar::tab:hover { background: #eaf1f9; }
#recognitionSettingsTabs QTabBar::tab:focus { border-top: 1px solid #6aa5e8; }
#ocrServicesDialog QFrame#recognitionModelPanel, #ocrServicesDialog QFrame#layoutServicePanel {
    background: #ffffff; border: 1px solid #d5dfea; border-radius: 9px;
}
#ocrServicesDialog QLabel#settingsPanelTitle { font-size: 12pt; font-weight: 700; color: #223950; }
#ocrServicesDialog QLabel#textMark {
    color: #1c5d9f; background: #e9f2fe; border-radius: 7px; font-size: 12pt; font-weight: 700;
}
#ocrServicesDialog QLabel#formulaMark {
    color: #38675c; background: #e7f3ee; border-radius: 7px; font-size: 17pt;
}
#ocrServicesDialog QLabel#settingsHint, #ocrServicesDialog QLabel#ocrDiscoveryStatus,
#ocrServicesDialog QLabel#comparisonSummary { color: #536980; }
#ocrServicesDialog QLabel#modelState {
    color: #465b70; background: #edf1f5; border-radius: 4px; padding: 3px 7px; font-weight: 600;
}
#ocrServicesDialog QLabel#modelState[availability="ready"] { color: #246342; background: #e6f4eb; }
#ocrServicesDialog QLabel#modelState[availability="offline"] { color: #8a4917; background: #fff0df; }
#ocrServicesDialog QLabel#formulaOutput { font-weight: 600; padding: 6px 0; }
#ocrServicesDialog QToolButton {
    color: #185ea9; background: transparent; border: 1px solid transparent; border-radius: 4px; padding: 3px;
}
#ocrServicesDialog QToolButton:hover { background: #edf4fc; }
#ocrServicesDialog QToolButton:focus { border-color: #6aa5e8; }
#ocrServicesDialog QLabel#comparisonWarning { color: #894510; }
#ocrServicesDialog QLineEdit:disabled, #ocrServicesDialog QComboBox:disabled {
    color: #708093; background: #f5f7fa;
}
#ocrServicesDialog QPushButton#primaryButton {
    background: #216ec1; color: white; border-color: #216ec1; font-weight: 700; padding: 7px 17px;
}
#ocrServicesDialog QPushButton#primaryButton:hover { background: #145fae; }
#ocrServicesDialog QPushButton#primaryButton:disabled {
    background: #e7edf4; color: #78899c; border-color: #d9e2ec;
}
#ocrServicesDialog QTableWidget {
    background: #ffffff; alternate-background-color: #f3f6fa;
    color: #334962; border: 1px solid #d5dfea; border-radius: 5px;
    selection-background-color: #daebfd; selection-color: #174d83;
}
#ocrServicesDialog QHeaderView::section {
    background: #eaf0f6; color: #435b72; font-weight: 600;
    padding: 7px 4px; border: 0; border-bottom: 1px solid #d5dfea;
}

QDockWidget#verificationQueue { color: #203b56; font-weight: 600; }
QDockWidget#verificationQueue::title {
    background: #e6eff8; border-bottom: 1px solid #c5d6e7;
    padding: 9px 12px; text-align: left;
}
QWidget#navigatorBody { background: #f7f9fc; }
QWidget#navigatorBody QPushButton[navigationCategory="true"] {
    background: #fff; color: #42576d; text-align: left;
    border: 1px solid #d4dfe9; border-radius: 6px; padding: 7px 10px;
}
QWidget#navigatorBody QPushButton[navigationCategory="true"]:hover { background: #eef4fa; }
QWidget#navigatorBody QPushButton[navigationCategory="true"]:checked {
    color: #124e86; background: #dfedfb; border-color: #86b2dd; font-weight: 600;
}
QWidget#navigatorBody QPushButton:focus { border: 1px solid #216ec1; }
QLabel#navigatorCount { color: #36516e; font-weight: 600; }
QLabel#navigatorEmpty { color: #52657a; background: #fff; border: 1px solid #dce4ee; border-radius: 6px; padding: 14px; }
QListView#verificationItems { background: #fff; border: 1px solid #dce4ee; border-radius: 6px; padding: 3px; color: #24354b; }
