set(CPACK_GENERATOR "DEB")
set(CPACK_PACKAGE_NAME "yagf2")
set(CPACK_PACKAGE_VENDOR "YAGF contributors")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "OCR editor for scanned documents and mathematical formulas")
set(CPACK_PACKAGE_DESCRIPTION "YAGF is a Qt 6 OCR editor with source-linked text correction, separate text and formula engines, optional remote page-layout services, and PDF, DjVu and LaTeX workflows.")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/andrei-b/YAGF")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/COPYING")
set(CPACK_STRIP_FILES ON)
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")

set(YAGF_PACKAGE_MAINTAINER "Andrei Borovskii" CACHE STRING
    "Debian package maintainer (defaults to the developer listed in AUTHORS)")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${YAGF_PACKAGE_MAINTAINER}")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
set(CPACK_DEBIAN_PACKAGE_RELEASE "1")
set(CPACK_DEBIAN_PACKAGE_SECTION "graphics")
set(CPACK_DEBIAN_PACKAGE_PRIORITY "optional")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_DEPENDS "tesseract-ocr, poppler-utils")
set(CPACK_DEBIAN_PACKAGE_RECOMMENDS "tesseract-ocr-eng, qt6-wayland, libenchant-2-2, hunspell-en-us")
set(CPACK_DEBIAN_PACKAGE_SUGGESTS "texlive-latex-base, texlive-latex-recommended, texlive-latex-extra, texlive-fonts-recommended, texlive-lang-cyrillic, cm-super-minimal, tesseract-ocr-rus, hunspell-ru, sane-utils, sane-airscan, djvulibre-bin, ocrmypdf")
include(CPack)
